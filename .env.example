# Public site URL for Stripe return links and canonical metadata.
# DNS for cottongymwear.com is not required to run or preview the shop.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Printful private token: Dashboard → Settings → API → Private token.
# Leave blank to serve the sample catalog and preview checkout.
PRINTFUL_API_KEY=

# Only if the token can access more than one Printful store.
PRINTFUL_STORE_ID=

# false keeps Printful orders as drafts (no fulfillment charge).
# Set true only after a draft order looks right in the Printful dashboard.
PRINTFUL_AUTO_CONFIRM=false

# Stripe secret key. Leave blank for preview checkout (no card charge).
STRIPE_SECRET_KEY=

# Signing secret for POST /api/webhooks/stripe (Stripe CLI or Dashboard).
STRIPE_WEBHOOK_SECRET=
